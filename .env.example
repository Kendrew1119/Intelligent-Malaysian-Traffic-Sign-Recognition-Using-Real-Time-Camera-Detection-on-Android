# ============================================
# MYSignVoice - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)

# --- Web Server ---
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# --- YOLO Model ---
YOLO_MODEL_PATH=./models/best.pt
YOLO_MODEL_FAMILY=YOLO26
YOLO_INPUT_SIZE=640
YOLO_END2END=true

# --- Inference Settings ---
CONFIDENCE_THRESHOLD=0.5
# Used only to merge overlapping full-frame and ROI detections. YOLO26's
# default end-to-end head is NMS-free, so this is not a model NMS setting.
MERGE_IOU_THRESHOLD=0.45
NUM_CLASSES=49

# --- Python (for training scripts) ---
PYTHON_PATH=python

# --- Google Colab / Google Drive ---
GDRIVE_MODEL_PATH=/content/drive/MyDrive/sign_model

# --- Upload Settings ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=png,jpg,jpeg,mp4,avi
