!.gitkeep

# --- Dataset Images (collect locally, too large for git) ---
/dataset/raw_images/*
/dataset/annotated/train/images/*
/dataset/annotated/train/labels/*
/dataset/annotated/val/images/*
/dataset/annotated/val/labels/*
/dataset/annotated/test/images/*
/dataset/annotated/test/labels/*
!/dataset/**/.gitkeep

